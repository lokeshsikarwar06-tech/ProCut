import 'dart:io';
import 'package:flutter/material.dart';
import 'package:image_picker/image_picker.dart';
import 'package:ffmpeg_kit_flutter_new_video/ffmpeg_kit.dart';
import 'package:ffmpeg_kit_flutter_new_video/return_code.dart';
import 'package:path_provider/path_provider.dart';
import 'template_model.dart';

class TemplateEditorScreen extends StatefulWidget {
  @override
  _TemplateEditorScreenState createState() => _TemplateEditorScreenState();
}

class _TemplateEditorScreenState extends State<TemplateEditorScreen> {
  final ImagePicker _picker = ImagePicker();
  bool _isExporting = false;
  double _exportProgress = 0.0;

  // सैंपल टेंप्लेट (3 स्लॉट्स वाला - बीट कटिंग के लिए)
  late VideoTemplate currentTemplate;

  @override
  void initState() {
    super.initState();
    currentTemplate = VideoTemplate(
      id: "beat_01",
      title: "Trending Beat Edit",
      audioPath: "/path/to/bg_audio.mp3",
      slots: [
        TemplateSlot(slotIndex: 0, duration: 2.5),
        TemplateSlot(slotIndex: 1, duration: 1.8),
        TemplateSlot(slotIndex: 2, duration: 3.2),
      ],
    );
  }

  // 1. यूज़र से फोटो/वीडियो सेलेक्ट करवाना
  Future<void> _pickMediaForSlot(int index) async {
    final XFile? file = await _picker.pickImage(source: ImageSource.gallery);
    if (file != null) {
      setState(() {
        currentTemplate.slots[index].userMediaPath = file.path;
      });
    }
  }

  // 2. Dynamic FFmpeg कमांड बनाकर वीडियो रेंडर करना
  Future<void> _exportVideo() async {
    // चेक करें कि सभी स्लॉट में मीडिया सिलेक्ट हुआ है या नहीं
    bool allSlotsFilled = currentTemplate.slots.every((slot) => slot.userMediaPath != null);
    if (!allSlotsFilled) {
      ScaffoldMessenger.of(context).showSnackBar(
        SnackBar(content: Text("कृपया सभी स्लॉट्स के लिए फोटो सिलेक्ट करें!")),
      );
      return;
    }

    setState(() {
      _isExporting = true;
    });

    final Directory appDocDir = await getApplicationDocumentsDirectory();
    final String outputPath = "${appDocDir.path}/final_output.mp4";

    // Dynamic FFmpeg Filter Complex कमांड बनाना
    String filterComplex = "";
    String inputs = "";

    for (int i = 0; i < currentTemplate.slots.length; i++) {
      var slot = currentTemplate.slots[i];
      inputs += "-loop 1 -t ${slot.duration} -i ${slot.userMediaPath} ";
      filterComplex += "[$i:v]scale=1080:1920:force_original_aspect_ratio=increase,crop=1080:1920[v$i]; ";
    }

    // सभी क्लिप्स को कंकेट (Concat) करना
    String concatMap = "";
    for (int i = 0; i < currentTemplate.slots.length; i++) {
      concatMap += "[v$i]";
    }
    filterComplex += "${concatMap}concat=n=${currentTemplate.slots.length}:v=1:a=0[outv]";

    // फाइनल FFmpeg कमांड
    String command = "$inputs -filter_complex \"$filterComplex\" -map \"[outv]\" -c:v libx264 -pix_fmt yuv420p -y $outputPath";

    // FFmpeg एक्सिक्यूशन
    FFmpegKit.execute(command).then((session) async {
      final returnCode = await session.getReturnCode();
      setState(() {
        _isExporting = false;
      });

      if (ReturnCode.isSuccess(returnCode)) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text("वीडियो सफलतापूर्वक एक्सपोर्ट हुआ: $outputPath")),
        );
      } else {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(content: Text("एक्सपोर्ट में खराबी आई।")),
        );
      }
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: Text(currentTemplate.title)),
      body: Column(
        children: [
          // 1. Preview Box / Timeline Section
          Expanded(
            child: Container(
              color: Colors.black12,
              child: Center(
                child: _isExporting
                    ? CircularProgressIndicator()
                    : Text("Template Preview Zone", style: TextStyle(fontSize: 18)),
              ),
            ),
          ),
          
          // 2. Slots Selection Grid
          Container(
            height: 140,
            padding: EdgeInsets.all(12),
            child: ListView.builder(
              scrollDirection: Axis.horizontal,
              itemCount: currentTemplate.slots.length,
              itemBuilder: (context, index) {
                var slot = currentTemplate.slots[index];
                return GestureDetector(
                  onTap: () => _pickMediaForSlot(index),
                  child: Container(
                    width: 90,
                    margin: EdgeInsets.only(right: 10),
                    decoration: BoxDecoration(
                      color: Colors.grey[300],
                      borderRadius: BorderRadius.circular(8),
                      border: Border.all(color: Colors.blueAccent, width: 2),
                      image: slot.userMediaPath != null
                          ? DecorationImage(
                              image: FileImage(File(slot.userMediaPath!)),
                              fit: BoxFit.cover,
                            )
                          : null,
                    ),
                    child: slot.userMediaPath == null
                        ? Column(
                            mainAxisAlignment: MainAxisAlignment.center,
                            children: [
                              Icon(Icons.add_a_photo, color: Colors.grey[700]),
                              SizedBox(height: 4),
                              Text("${slot.duration}s", style: TextStyle(fontSize: 12)),
                            ],
                          )
                        : null,
                  ),
                );
              },
            ),
          ),

          // 3. Export Button
          Padding(
            padding: const EdgeInsets.all(16.0),
            child: ElevatedButton(
              onPressed: _isExporting ? null : _exportVideo,
              style: ElevatedButton.styleFrom(
                minimumSize: Size(double.infinity, 50),
                backgroundColor: Colors.redAccent,
              ),
              child: Text(_isExporting ? "Rendering Video..." : "Export Video", style: TextStyle(fontSize: 18, color: Colors.white)),
            ),
          )
        ],
      ),
    );
  }
}
