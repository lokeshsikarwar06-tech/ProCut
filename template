class TemplateSlot {
  final int slotIndex;
  final double duration; // सेकंड्स में
  String? userMediaPath; // यूज़र द्वारा चुनी गई फोटो/वीडियो का पाथ

  TemplateSlot({
    required this.slotIndex,
    required this.duration,
    this.userMediaPath,
  });
}

class VideoTemplate {
  final String id;
  final String title;
  final String audioPath; // बैकग्राउंड म्यूजिक
  final List<TemplateSlot> slots;

  VideoTemplate({
    required this.id,
    required this.title,
    required this.audioPath,
    required this.slots,
  });
}
